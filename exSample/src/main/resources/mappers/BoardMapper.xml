	<!-- 3. 전체목록 리스트 -->
	<select id="boardList" resultType="com.mnu.sample.domain.BoardDTO">
		select * from tbl_board order by idx desc
	</select>
	
	<!-- 3-1. 전체목록 리스트(페이지 인덱싱) -->
	<select id="boardListPage" resultType="com.mnu.sample.domain.BoardDTO">
		select * from tbl_board order by idx desc 
			offset #{offset} rows fetch next #{maxlist} rows only
	</select>
	
